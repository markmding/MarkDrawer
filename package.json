{
  "name": "mark-drawer",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "description": "Mark Drawer 文屉 — a local-first Markdown drawer",
  "scripts": {
    "dev": "vite",
    "build": "npm run version:check && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "version:check": "node tools/version.mjs check",
    "version:dev": "node tools/version.mjs dev",
    "version:release": "node tools/version.mjs release",
    "version:bump": "node tools/version.mjs bump",
    "icons": "node tools/gen-icons.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "npm run version:check && tauri build --no-bundle",
    "desktop:installer": "npm run version:check && tauri build",
    "package:portable": "npm run version:check && node tools/package-portable.mjs",
    "package:source": "npm run version:check && node tools/package-source.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@milkdown/crepe": "^7.15.5",
    "@milkdown/kit": "^7.15.5",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "codemirror": "^6.0.2",
    "katex": "^0.16.25",
    "mermaid": "^11.12.1",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "svelte": "^5.43.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.9.1",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
